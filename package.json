{
  "name": "creatoros",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local AI creator operations workspace with persistent embedded browser profiles.",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 file:dist-electron/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build && tsc -p tsconfig.main.json && tsc -p tsconfig.tools.json",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gate:fast": "npm run lint && npm run typecheck && npm run build && npm run test",
    "gate": "npm run gate:fast && npm run test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "mcp": "tsx scripts/mcp-stdio.ts",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "mcp:built": "node dist-tools/mcp-stdio.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@uiw/react-codemirror": "^4.25.11",
    "chokidar": "^5.0.0",
    "drizzle-orm": "^1.0.0-beta.16-c2458b2",
    "fastify": "^5.6.1",
    "nanoid": "^5.1.5",
    "node-cron": "^4.2.1",
    "react": "^19.1.1",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.5",
    "electron": "44.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "local.creatoros.desktop",
    "productName": "CreatorOS",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-tools/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
