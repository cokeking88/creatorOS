# Optional real LLM provider. The app runs with MockProvider without these.
CREATOROS_AGENT_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Local gateway. Defaults are localhost only.
CREATOROS_GATEWAY_HOST=127.0.0.1
CREATOROS_GATEWAY_PORT=17890
CREATOROS_GATEWAY_TOKEN=change-me

# Optional Feishu verification token for your own adapter implementation.
FEISHU_VERIFICATION_TOKEN=
