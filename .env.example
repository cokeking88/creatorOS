# Agent engine: Anthropic-protocol gateway (optional override; default https://api.anthropic.com).
# All fields can also be configured at runtime on the Settings page (saved to the
# settings table and applied to the next agent run without a restart).
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Local gateway. Defaults are localhost only.
CREATOROS_GATEWAY_HOST=127.0.0.1
CREATOROS_GATEWAY_PORT=17890
CREATOROS_GATEWAY_TOKEN=change-me

# Optional Feishu verification token for your own adapter implementation.
FEISHU_VERIFICATION_TOKEN=
